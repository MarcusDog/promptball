{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "PromptBall",
  "version": "0.1.0",
  "identifier": "com.promptball.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "security": {
      "csp": null
    },
    "windows": [
      {
        "label": "main",
        "title": "PromptBall",
        "width": 66,
        "height": 66,
        "minWidth": 66,
        "minHeight": 66,
        "decorations": false,
        "transparent": true,
        "shadow": false,
        "alwaysOnTop": true,
        "resizable": true,
        "visible": true
      }
    ]
  },
  "bundle": {
    "active": true,
    "targets": "all"
  }
}
